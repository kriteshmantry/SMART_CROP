# Backend Environment Configuration (.env.example)

# Port & Host
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (Comma-separated list of allowed frontend URLs, or * for open access)
# Example: https://your-frontend-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://localhost:3000

# Database URLs
# For Local/SQLite:
# DATABASE_URL=sqlite:///./smartcrop.db
# LOGIN_DATABASE_URL=sqlite:///./login_details.db
#
# For Production Cloud PostgreSQL (Supabase, Neon, Railway, RDS):
# DATABASE_URL=postgresql://postgres:your_password@ep-sample.us-east-1.aws.neon.tech/neondb
# LOGIN_DATABASE_URL=postgresql://postgres:your_password@ep-sample.us-east-1.aws.neon.tech/neondb

# OpenAI API Key (for Chat assistant)
OPENAI_API_KEY=your-openai-api-key-here
